# Turium AI Knowledge Inbox - Environment Configuration
APP_NAME="Turium AI Knowledge Inbox"
APP_ENV="development"
DEBUG=true
PORT=8000
HOST="0.0.0.0"

# Groq Configuration (Free & Ultra-Fast inference)
# Get your free key at: https://console.groq.com/keys
GROQ_API_KEY=""
GROQ_MODEL="openai/gpt-oss-120b"

# Optional: OpenAI Configuration
OPENAI_API_KEY=""
EMBEDDING_MODEL="text-embedding-3-small"
LLM_MODEL="gpt-4o-mini"

# Text Splitter Settings (Unstructured document chunking)
CHUNK_SIZE=500
CHUNK_OVERLAP=80
DEFAULT_TOP_K=3
SPLITTER_TYPE="unstructured_recursive"

DATABASE_PATH="knowledge_inbox.db"
